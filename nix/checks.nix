# `nix flake check`: build kitty (running its test suite) and make sure the
# Material You configuration, alone and combined with themes generated by
# Material-You-Terminal, is accepted by it.
{ pkgs, self, material-you-terminal }:

let
  inherit (pkgs) lib;
  kitty = self.packages.${pkgs.stdenv.hostPlatform.system}.default;
  material = import ./settings.nix;
  settings = material.shapes // material.motion // material.shaders;
  settingsConf = pkgs.writeText "material-you-settings.conf"
    (lib.concatStringsSep "\n" (lib.mapAttrsToList (k: v: "${k} ${v}") settings) + "\n");

  # Fails on unknown options and unparsable values
  kittyCheck = pkgs.writeShellScript "kitty-check" ''
    for conf in "$@"; do
      echo "checking $conf"
      res=$(${kitty}/bin/kitty +runpy "
    import sys
    from kitty.config import load_config
    bad = []
    load_config(sys.argv[-1], accumulate_bad_lines=bad)
    for b in bad:
        print('bad line', b.number, repr(b.line), b.exception)
    " "$conf" 2>&1)
      echo "$res"
      if echo "$res" | grep -qiE "bad line|unknown|error"; then exit 1; fi
    done
  '';

  mytTheme = args: material-you-terminal.lib.mkTheme pkgs args;
in
{
  package = kitty;

  # The settings of the home-manager module are the same as extras/material-you.conf
  settings-in-sync = pkgs.runCommandLocal "kitty-material-you-settings-in-sync" { } ''
    while IFS= read -r line; do
      [ -z "$line" ] && continue
      if ! grep -qxF -- "$line" ${../extras/material-you.conf}; then
        echo "extras/material-you.conf is missing: $line (from nix/settings.nix)"
        exit 1
      fi
    done < ${settingsConf}
    touch $out
  '';

  config = pkgs.runCommandLocal "kitty-material-you-config" { } ''
    export HOME=$TMPDIR
    ${kittyCheck} ${settingsConf} ${../extras/material-you.conf} ${../extras/themes}/material-you-dark.conf ${../extras/themes}/material-you-light.conf
    for mode in dark light; do
      cat ${settingsConf} > $TMPDIR/$mode.conf
      echo "include ${../extras/themes}/material-you-$mode.conf" >> $TMPDIR/$mode.conf
      ${kittyCheck} $TMPDIR/$mode.conf
    done
    touch $out
  '';

  # Themes generated by Material-You-Terminal combined with the Material You settings
  material-you-terminal = pkgs.runCommandLocal "kitty-material-you-with-myt" { } ''
    export HOME=$TMPDIR
    i=0
    for theme in ${mytTheme { }} ${mytTheme { mode = "light"; source.color = "#B3261E"; scheme = "scheme-expressive"; }}; do
      i=$((i + 1))
      { cat ${settingsConf}; echo "include $theme/kitty.conf"; } > $TMPDIR/kitty-$i.conf
      ${kittyCheck} $TMPDIR/kitty-$i.conf
    done
    touch $out
  '';
}
